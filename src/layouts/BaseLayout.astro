---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

export interface Props {
    title?: string;
    description?: string;
    /** "personal" swaps the accent to orange-led; default is green-led academic */
    accent?: "academic" | "personal";
}

const {
    title = "Dominik Babić",
    description = "Dominik Babić — AI engineer and researcher. Projects, writing and notes on machine learning, security and running.",
    accent = "academic",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;

const navItems = [
    { label: "Projects", href: "/projects", match: "/projects" },
    { label: "Blog", href: "/blog/tech", match: "/blog" },
    { label: "About", href: "/about/tech", match: "/about" },
];
---
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="sitemap" href="/sitemap-index.xml" />
        <link rel="alternate" type="application/rss+xml" title="Dominik Babić — Blog" href="/rss.xml" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta name="twitter:card" content="summary" />
        <script is:inline>
            // Resolve the theme before first paint, and again after every
            // client-side swap (the ClientRouter replaces the <html> attributes).
            (() => {
                if (window.__themeInit) return;
                window.__themeInit = true;
                const apply = () => {
                    const stored = localStorage.getItem("theme");
                    const theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
                    document.documentElement.dataset.theme = theme;
                };
                apply();
                document.addEventListener("astro:after-swap", apply);
            })();
        </script>
        <ClientRouter />
    </head>
    <body data-accent={accent === "personal" ? "personal" : undefined} class="min-h-screen flex flex-col font-sans antialiased">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:px-3 focus:py-2 focus:bg-raised focus:border focus:border-line font-mono text-xs">
            Skip to content
        </a>

        <header class="sticky top-0 z-50 w-full bg-bg/90 backdrop-blur-sm border-b border-line">
            <nav class="max-w-3xl mx-auto flex items-center justify-between gap-4 px-4 h-14" aria-label="Main">
                <a href="/" class="font-serif font-semibold tracking-tight text-ink hover:text-accent transition-colors duration-150">
                    Dominik Babić
                </a>
                <div class="flex items-center gap-5 sm:gap-6">
                    {navItems.map((item) => (
                        <a
                            href={item.href}
                            class="nav-link"
                            aria-current={path.startsWith(item.match) ? "page" : undefined}
                        >
                            {item.label}
                        </a>
                    ))}
                    <button
                        id="theme-toggle"
                        type="button"
                        aria-label="Toggle color scheme"
                        class="text-muted hover:text-accent transition-colors duration-150 cursor-pointer"
                    >
                        <svg class="w-4 h-4 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
                        </svg>
                        <svg class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                    </button>
                </div>
            </nav>
        </header>

        <main id="main-content" class="flex-1 max-w-3xl mx-auto w-full px-4 py-10">
            <slot />
        </main>

        <footer class="border-t border-line mt-16">
            <div class="max-w-3xl mx-auto px-4 py-8 flex flex-wrap items-center justify-between gap-4 font-mono text-xs text-faint">
                <span>© {new Date().getFullYear()} Dominik Babić · Zagreb, HR</span>
                <span class="flex items-center gap-4">
                    <a href="/rss.xml" class="hover:text-accent transition-colors duration-150">rss</a>
                    <a href="https://github.com/dominik-babic" class="hover:text-accent transition-colors duration-150">github</a>
                    <a href="https://strava.com/athletes/72844955" class="hover:text-pop transition-colors duration-150">strava</a>
                </span>
            </div>
        </footer>

        <script>
            // Theme toggle — persists the choice and lets embedded widgets (giscus) resync.
            const bindThemeToggle = () => {
                document.getElementById("theme-toggle")?.addEventListener("click", () => {
                    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
                    document.documentElement.dataset.theme = next;
                    localStorage.setItem("theme", next);
                    document.dispatchEvent(new CustomEvent("theme-change"));
                });
            };
            document.addEventListener("astro:page-load", bindThemeToggle);

            // Skip entry animations when toggling between sibling sections (blog/about tabs),
            // so the tab switch feels like a state change rather than a page load.
            document.addEventListener("astro:before-swap", (e) => {
                const from = (e as any).from?.pathname ?? "";
                const to = (e as any).to?.pathname ?? "";
                const isSectionToggle =
                    (from.startsWith("/blog") && to.startsWith("/blog")) ||
                    (from.startsWith("/about") && to.startsWith("/about"));
                if (isSectionToggle) {
                    (e as any).newDocument.querySelectorAll("[data-no-toggle-anim]").forEach((el: HTMLElement) => {
                        el.style.animation = "none";
                        el.style.opacity = "1";
                        el.style.transform = "none";
                    });
                }
            });
        </script>
    </body>
</html>
