---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";

const projects = await getCollection("projects");
const featured = projects.filter((p: CollectionEntry<"projects">) => p.data.featured);

const blogs = await getCollection("blog");
const featuredBlogs = blogs.filter((b: CollectionEntry<"blog">) => b.data.featured);

const tips = await getCollection("tips");
tips.sort((a: CollectionEntry<"tips">, b: CollectionEntry<"tips">) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
// Show the tip matching the build month; fall back to the most recent one.
// A monthly scheduled rebuild in CI keeps this fresh (see .github/workflows/astro.yml).
const now = new Date();
const currentMonthTip = tips.find((t: CollectionEntry<"tips">) => {
    const d = new Date(t.data.date);
    return d.getFullYear() === now.getFullYear() && d.getMonth() === now.getMonth();
});
const latestTip = currentMonthTip ?? tips[0] ?? null;
const tipLabel = currentMonthTip ? "Tip of the month" : "Latest tip";
---
<BaseLayout title="Dominik Babić">
    <section class="pt-4 pb-10 fade-in-up">
        <p class="text-gray-400 text-sm tracking-wide uppercase font-medium">Archive on some of my findings and projects which I wanted to share</p>
    </section>

    {latestTip && (
        <section class="mb-14 fade-in-up">
            <div class="border border-gray-200 rounded-xl p-7 bg-white/70 backdrop-blur-sm">
                <div class="flex items-center gap-3 mb-4">
                    <span class="text-amber-500 text-sm">✦</span>
                    <span class="text-xs font-semibold tracking-widest uppercase text-gray-400">{tipLabel}</span>
                    <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-700 border border-amber-500/20">
                        {latestTip.data.category}
                    </span>
                </div>
                <h2 class="text-xl font-semibold text-gray-900 mb-3">{latestTip.data.title}</h2>
                <p class="text-gray-600 leading-relaxed text-sm">{latestTip.data.summary}</p>
            </div>
        </section>
    )}

    <section class="mb-14 fade-in-up delay-100">
        <div class="flex items-center gap-3 mb-7">
            <h2 class="text-2xl font-semibold text-gray-900">Featured Projects</h2>
            <div class="flex-1 h-px bg-gray-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {featured.map((project: CollectionEntry<"projects">) => (
                <ProjectCard
                    title={project.data.title}
                    description={project.data.description}
                    github={project.data.github}
                    link={`/projects/${project.id}`}
                    hasDetailPage={project.data.hasDetailPage}
                    tags={project.data.tags}
                />
            ))}
        </div>
    </section>

    <section class="fade-in-up delay-200">
        <div class="flex items-center gap-3 mb-7">
            <h2 class="text-2xl font-semibold text-gray-900">Featured Blogs</h2>
            <div class="flex-1 h-px bg-gray-200"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            {featuredBlogs.map((blog: CollectionEntry<"blog">) => (
                <ProjectCard
                    title={blog.data.title}
                    description={blog.data.description}
                    link={`/blog/${blog.id}`}
                    hasDetailPage={true}
                    tags={blog.data.tags}
                />
            ))}
        </div>
    </section>
</BaseLayout>
