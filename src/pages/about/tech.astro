---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfoCard from "../../components/InfoCard.astro";
import ToggleNav from "../../components/ToggleNav.astro";
import { Image } from "astro:assets";
import profileImg from "../../assets/img/cv_nova_small.jpg";

const toggleOptions = [
    { label: "Tech", href: "/about/tech" },
    { label: "Personal", href: "/about/personal" },
];
---
<BaseLayout title="About — Dominik Babić" description="AI engineer and computer vision researcher with an MSc from the University of Zagreb and KTH.">
    <!-- Hero -->
    <div class="mb-14">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 mb-10">
            <Image
                transition:name="about-photo"
                src={profileImg}
                alt="Dominik Babić"
                width={144}
                height={144}
                densities={[1, 2]}
                loading="eager"
                class="w-36 h-36 object-cover rounded-sm border border-line hover:grayscale-40 transition-all duration-300 shrink-0"
            />
            <div class="text-center sm:text-left flex-1">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                    <h1 data-no-toggle-anim class="font-serif text-4xl font-bold tracking-tight fade-in-up">About</h1>
                    <ToggleNav options={toggleOptions} active="/about/tech" transitionName="about-toggle" />
                </div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-faint fade-in-up">
                    AI engineer · CV researcher · competitive runner
                </p>
            </div>
        </div>

        <div class="fade-in-up space-y-4 text-muted leading-relaxed">
            <p>
                I'm a machine learning engineer and cybersecurity enthusiast with a
                <strong class="text-ink font-medium">Master's in Computer Science</strong> from the University of Zagreb
                and KTH Royal Institute of Technology in Sweden. My work spans deep learning, computer vision and
                security research — built up through research collaborations, hackathons, and independent projects.
            </p>
            <p>
                Lately I've been moving into <strong class="text-ink font-medium">robotics and automation</strong>,
                working with ROS and ROS 2. It's a natural extension of the AI background: bridging the gap between
                intelligent algorithms and physical autonomous systems, especially where machine learning can improve
                robotic perception and decision-making in the real world.
            </p>
            <p>
                Away from the keyboard I'm a <strong class="text-ink font-medium">competitive middle- and long-distance runner</strong> —
                racing everything from 400m to the marathon across the European running scene.
            </p>
        </div>
    </div>

    <!-- Education -->
    <section class="mb-14">
        <div class="flex items-baseline gap-3 mb-4 fade-in-up">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">01</span>
            <h2 class="font-serif text-2xl font-semibold">Education</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <div class="fade-in-up space-y-8">
            <InfoCard
                institution="Faculty of Electrical Engineering and Computing, University of Zagreb, Croatia"
                degree="MSc in Computer Science"
                specialization="Artificial Intelligence and Computer Vision"
                list={["Top 2% of the generation, GPA 4.79/5.0.", "Relevant courses: Machine Learning, Pattern Recognition, Computer Vision, Deep Learning."]}
                startDate="2023"
                endDate="2025"
            />
            <InfoCard
                institution="KTH Royal Institute of Technology, Sweden"
                degree="MSc in Computer Science — Exchange"
                list={["Collaborated on a reproducibility research paper: an in-depth exploration of Finite Scalar Quantization with VAEs.", "Relevant courses: Deep Learning Advanced, Security in Computer Systems, Reinforcement Learning."]}
                startDate="2024"
                endDate="2025"
            />
            <InfoCard
                institution="Faculty of Electrical Engineering and Computing, University of Zagreb, Croatia"
                degree="BSc in Computer Science"
                list={["Top 5% of the generation, GPA 4.54/5.0.", "Bachelor's thesis awarded the highest grade for research on Vector Quantized Variational Autoencoders (VQ-VAE)."]}
                startDate="2020"
                endDate="2023"
            />
        </div>
    </section>

    <!-- Experience -->
    <section class="mb-14">
        <div class="flex items-baseline gap-3 mb-4 fade-in-up">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">02</span>
            <h2 class="font-serif text-2xl font-semibold">Experience</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <div class="fade-in-up space-y-8">
            <InfoCard
                institution="Gideon Brothers d.o.o."
                degree="Junior R&D Engineer"
                description="Developing autonomous mobile robots, coordination algorithms, and simulation environments."
                startDate="2025"
                endDate="now"
            />
            <InfoCard
                institution="Visual Recognition Group, CTU in Prague, Czech Republic"
                degree="Deep Learning Researcher"
                description="Researched detection of maliciously crafted image content; developed a novel method for detecting generated adversarial images with over 90% accuracy."
                startDate="2025"
                endDate="2025"
            />
            <InfoCard
                institution="Faculty of Electrical Engineering and Computing, University of Zagreb, Croatia"
                degree="Teaching Assistant"
                description="Facilitated exercises, graded assignments and exams, and mentored students across more than eight courses."
                startDate="2023"
                endDate="2025"
            />
            <InfoCard
                institution="Syskit d.o.o."
                degree="Full Stack Developer Intern"
                description="Contributed to the development and maintenance of a SaaS React-based web and Microsoft Teams app."
                startDate="2022"
                endDate="2023"
            />
        </div>
    </section>

    <!-- Skills -->
    <section class="mb-14">
        <div class="flex items-baseline gap-3 mb-4 fade-in-up">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">03</span>
            <h2 class="font-serif text-2xl font-semibold">Skills</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <div class="grid sm:grid-cols-2 gap-x-10 gap-y-6 fade-in-up">
            <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-faint mb-3">Focus</h3>
                <ul class="space-y-1.5 text-sm text-muted">
                    <li>Deep learning &amp; neural networks</li>
                    <li>Computer vision</li>
                    <li>Natural language processing</li>
                    <li>Reinforcement learning</li>
                    <li>Robotics &amp; automation</li>
                </ul>
            </div>
            <div>
                <h3 class="font-mono text-xs uppercase tracking-widest text-faint mb-3">Toolbox</h3>
                <ul class="space-y-1.5 font-mono text-sm text-muted">
                    <li>Python · PyTorch · TensorFlow</li>
                    <li>C++ · CUDA · OpenCV</li>
                    <li>JavaScript · React · Node.js</li>
                    <li>ROS 2 · Docker · AWS</li>
                    <li>Git · Linux · security tooling</li>
                </ul>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section class="fade-in-up">
        <div class="flex items-baseline gap-3 mb-4">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">04</span>
            <h2 class="font-serif text-2xl font-semibold">Contact</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <p class="text-muted leading-relaxed mb-6 max-w-[62ch]">
            Whether you want to discuss opportunities, collaborate on a project, talk shop — or join me for a run — I'd love to connect.
        </p>
        <div class="flex flex-wrap gap-3 font-mono text-xs">
            <a href="/assets/cv.pdf" target="_blank" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150">
                cv.pdf ↓
            </a>
            <a href="mailto:babic.dominik13@gmail.com" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150">
                email
            </a>
            <a href="https://www.linkedin.com/in/dominik-babić/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150">
                linkedin ↗
            </a>
            <a href="https://github.com/dominik-babic" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150">
                github ↗
            </a>
            <a href="https://strava.com/athletes/72844955" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-pop hover:text-pop transition-colors duration-150">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
                </svg>
                strava ↗
            </a>
        </div>
    </section>
</BaseLayout>
