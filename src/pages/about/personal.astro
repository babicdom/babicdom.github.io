---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToggleNav from "../../components/ToggleNav.astro";
import { Image } from "astro:assets";
import profileImg from "../../assets/img/personal_img.jpg";

const toggleOptions = [
    { label: "Tech", href: "/about/tech" },
    { label: "Personal", href: "/about/personal" },
];

// Race card — fill in PBs as they fall
const raceCard = [
    { event: "400m", pb: "—" },
    { event: "800m", pb: "—" },
    { event: "1500m", pb: "—" },
    { event: "Half marathon", pb: "—" },
    { event: "Marathon", pb: "—" },
];
---
<BaseLayout title="About — Dominik Babić" description="Runner, gamer, occasional reader. The side of the site that doesn't fit in a CV." accent="personal">
    <!-- Hero -->
    <div class="mb-14">
        <div class="flex flex-col sm:flex-row items-center sm:items-start gap-8 mb-10">
            <Image
                transition:name="about-photo"
                src={profileImg}
                alt="Dominik Babić"
                width={144}
                height={144}
                densities={[1, 2]}
                loading="eager"
                class="w-36 h-36 object-cover rounded-sm border border-line hover:grayscale-40 transition-all duration-300 shrink-0"
            />
            <div class="text-center sm:text-left flex-1">
                <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-3">
                    <h1 data-no-toggle-anim class="font-serif text-4xl font-bold tracking-tight fade-in-up">About</h1>
                    <ToggleNav options={toggleOptions} active="/about/personal" transitionName="about-toggle" />
                </div>
                <p class="font-mono text-xs uppercase tracking-[0.2em] text-faint fade-in-up">
                    runner · gamer · occasional reader
                </p>
            </div>
        </div>

        <div class="fade-in-up space-y-4 text-muted leading-relaxed">
            <p>
                This is the part of the page where I get to drop the résumé language. I'm Dominik — I write code for a
                living, run competitively for fun, and spend more time thinking about both than I probably should.
            </p>
            <p>
                I grew up in Croatia and have since lived and studied in Sweden, worked in the Czech Republic, and raced
                across a good chunk of Europe. I like moving around, both literally and figuratively.
            </p>
            <p>
                This side of the site is where I write about things that don't fit neatly into a CV — race reports,
                trips, things I've been reading, things I've been thinking about.
            </p>
        </div>
    </div>

    <!-- Running -->
    <section class="mb-14">
        <div class="flex items-baseline gap-3 mb-4 fade-in-up">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">01</span>
            <h2 class="font-serif text-2xl font-semibold">Running</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <div class="fade-in-up">
            <p class="text-muted leading-relaxed mb-6 max-w-[62ch]">
                I'm a competitive middle- and long-distance runner, member of
                <a href="https://www.akkvarner.hr/" target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">AK Kvarner</a>.
                I race distances from 400m to the marathon, mostly at Croatian and European competitions.
            </p>

            <!-- Race card — styled like a results board -->
            <table class="w-full font-mono text-sm border-t border-line">
                <caption class="sr-only">Personal bests by event</caption>
                <thead>
                    <tr class="text-left text-xs uppercase tracking-widest text-faint">
                        <th scope="col" class="py-2.5 font-medium">event</th>
                        <th scope="col" class="py-2.5 font-medium text-right">personal best</th>
                    </tr>
                </thead>
                <tbody>
                    {raceCard.map((row) => (
                        <tr class="border-t border-line">
                            <td class="py-2.5 text-ink">{row.event}</td>
                            <td class="py-2.5 text-right tabular-nums text-muted">{row.pb}</td>
                        </tr>
                    ))}
                </tbody>
            </table>

            <div class="mt-6">
                <a class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs font-mono text-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150" href="https://strava.com/athletes/72844955" target="_blank" rel="noopener noreferrer">
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
                    </svg>
                    follow on strava ↗
                </a>
            </div>
        </div>
    </section>

    <!-- Outside running -->
    <section class="mb-14">
        <div class="flex items-baseline gap-3 mb-4 fade-in-up">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">02</span>
            <h2 class="font-serif text-2xl font-semibold">Outside running</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <div class="fade-in-up divide-y divide-line border-b border-line">
            <div class="py-5">
                <h3 class="font-serif text-lg font-semibold mb-1.5">Gaming</h3>
                <p class="text-sm text-muted leading-relaxed">Mostly FIFA, occasionally something else on Steam when a game catches my eye. Not a serious gamer — just something to switch off with.</p>
            </div>
            <div class="py-5">
                <h3 class="font-serif text-lg font-semibold mb-1.5">Reading</h3>
                <p class="text-sm text-muted leading-relaxed">I read more non-fiction than fiction, mostly science, history, and the occasional biography. Thought it would make me a better writer. The jury's still out.</p>
            </div>
            <div class="py-5">
                <h3 class="font-serif text-lg font-semibold mb-1.5">Travel</h3>
                <p class="text-sm text-muted leading-relaxed">A lot of my travel is race-motivated — showing up in a new city, running a race, exploring the surroundings.</p>
            </div>
        </div>
    </section>

    <!-- Connect -->
    <section class="fade-in-up">
        <div class="flex items-baseline gap-3 mb-4">
            <span class="font-mono text-xs text-pop tabular-nums" aria-hidden="true">03</span>
            <h2 class="font-serif text-2xl font-semibold">Say hello</h2>
            <div class="flex-1 border-b border-line self-center"></div>
        </div>
        <p class="text-muted leading-relaxed mb-6 max-w-[62ch]">Whether it's to talk running, life, or anything in between.</p>
        <div class="flex flex-wrap gap-3 font-mono text-xs">
            <a href="mailto:babic.dominik13@gmail.com" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150">
                email
            </a>
            <a href="https://www.strava.com/athletes/72844955" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2.5 border border-line rounded-xs text-ink hover:border-accent hover:text-accent transition-colors duration-150">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M15.387 17.944l-2.089-4.116h-3.065L15.387 24l5.15-10.172h-3.066m-7.008-5.599l2.836 5.598h4.172L10.463 0l-7 13.828h4.169"/>
                </svg>
                strava ↗
            </a>
        </div>
    </section>
</BaseLayout>
