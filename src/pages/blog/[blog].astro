---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Comments from "../../components/Comments.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const blogs = await getCollection("blog");
  return blogs.map((blog: CollectionEntry<"blog">) => ({
    params: { blog: blog.id },
    props: { entry: blog },
  }));
}

type Props = { entry: CollectionEntry<"blog"> };
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
    <div class="mb-8">
        <h1 class="text-4xl font-bold mb-4 fade-in-up">{entry.data.title}</h1>

        <div class="flex flex-wrap items-center gap-4 mb-4 fade-in-up delay-100">
            {entry.data.date && (
                <time class="text-gray-500 text-sm flex items-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                    {entry.data.date}
                </time>
            )}
        </div>
    </div>

    <article class="prose prose-emerald mt-6 max-w-none fade-in-up delay-200">
      <Content />
    </article>

    <Comments />
</BaseLayout>
