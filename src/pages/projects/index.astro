---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
projects.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(projects.flatMap(project => project.data.tags || []))].sort();
---
<BaseLayout title="Projects" description="ML, cybersecurity and research work, together with personal projects.">
    <div class="fade-in-up">
        <h1 class="text-4xl font-bold mb-4">Projects</h1>
        <p class="text-gray-500 mb-8">A collection of my ML, Cybersecurity, and research work together with my personal projects.</p>
    </div>

    <div class="mb-8 fade-in-up delay-100">
        <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="text-lg font-medium text-gray-700">Filter by:</span>
            <button class="filter-btn active" data-filter="all" aria-pressed="true">
                All ({projects.length})
            </button>
            {allTags.map((tag) => {
                const count = projects.filter(p => p.data.tags?.includes(tag)).length;
                return (
                    <button class="filter-btn" data-filter={tag} aria-pressed="false">
                        {tag} ({count})
                    </button>
                );
            })}
        </div>
        <div class="flex items-center gap-2 text-sm text-gray-500">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span id="results-count">{projects.length} projects found</span>
        </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6 fade-in-up delay-200">
        {
            projects.map((project) => (
                <ProjectCard
                    title={project.data.title}
                    description={project.data.description}
                    github={project.data.github}
                    hasDetailPage={project.data.hasDetailPage}
                    link={`/projects/${project.id}`}
                    tags={project.data.tags}
                />
            ))
        }
    </div>

    <!-- No results message -->
    <div id="no-results" class="hidden text-center py-12 fade-in-up delay-300">
        <div class="text-gray-400 mb-4">
            <svg class="w-16 h-16 mx-auto mb-4 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <h3 class="text-xl font-semibold mb-2">No projects found</h3>
            <p>Try selecting a different tag or view all projects.</p>
        </div>
    </div>

    <script>
        import { initFilter } from '../../scripts/filterGrid';
        initFilter({
            itemSelector: '.project-item',
            gridId: 'projects-grid',
            noResultsId: 'no-results',
            resultsCountId: 'results-count',
            labelSingular: 'project',
            labelPlural: 'projects',
        });
    </script>
</BaseLayout>
