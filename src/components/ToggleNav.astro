---
export interface Props {
    options: { label: string; href: string }[];
    active: string;
    transitionName: string;
}
const { options, active, transitionName } = Astro.props;
---
<div class="inline-flex items-center p-1 rounded-full bg-gray-100 border border-gray-200 gap-0.5">
    {options.map(opt => {
        const isActive = opt.href === active;
        return isActive ? (
            <span
                transition:name={transitionName}
                class="px-5 py-2 rounded-full text-sm font-semibold bg-white text-gray-900 shadow-sm border border-gray-200/60 cursor-default"
            >
                {opt.label}
            </span>
        ) : (
            <a
                href={opt.href}
                class="px-5 py-2 rounded-full text-sm font-medium text-gray-500 hover:text-gray-700 transition-colors duration-200"
            >
                {opt.label}
            </a>
        );
    })}
</div>
