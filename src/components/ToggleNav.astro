---
export interface Props {
    options: { label: string; href: string }[];
    active: string;
    transitionName: string;
    class?: string;
}
const { options, active, transitionName, class: className } = Astro.props;
---
<div class:list={["inline-flex w-fit items-center border border-line rounded-xs overflow-hidden font-mono text-xs uppercase tracking-wider", className]}>
    {options.map(opt => {
        const isActive = opt.href === active;
        return isActive ? (
            <span
                transition:name={transitionName}
                class="px-4 py-2 bg-ink text-bg cursor-default"
                aria-current="page"
            >
                {opt.label}
            </span>
        ) : (
            <a
                href={opt.href}
                class="px-4 py-2 text-muted hover:text-ink hover:bg-accent-soft transition-colors duration-150"
            >
                {opt.label}
            </a>
        );
    })}
</div>
