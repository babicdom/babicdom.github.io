---
export interface Props {
    institution?: string;
    degree?: string;
    specialization?: string;
    description?: string;
    list?: Array<string>;
    startDate?: string;
    endDate?: string;
}

const { institution = "University of Zagreb, Croatia", degree = "Master of Science in Computer Science", specialization, description, list, startDate = "2022", endDate = "2024" } = Astro.props;
---
<div class="grow">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between mb-2">
        <h3 class="text-xl font-semibold text-emerald-600">{degree}</h3>
        <span class="text-gray-500 text-sm mt-1 sm:mt-0 font-medium">{startDate} - {endDate}</span>
    </div>
    <p class="text-gray-700 font-medium mb-1">{institution}</p>
    {specialization && <p class="text-gray-500 text-sm mb-3">Specialization in {specialization}</p>}
    {description && <p class="text-gray-700 text-sm leading-relaxed">{description}</p>}
    {
        list && (list.map((item) => {
            return <p class="text-gray-700 text-sm leading-relaxed">• {item}</p>;
        }))
    }
</div>