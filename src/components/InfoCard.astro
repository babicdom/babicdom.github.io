---
export interface Props {
    institution?: string;
    degree?: string;
    specialization?: string;
    description?: string;
    list?: Array<string>;
    startDate?: string;
    endDate?: string;
}

const { institution = "University of Zagreb, Croatia", degree = "Master of Science in Computer Science", specialization, description, list, startDate = "2022", endDate = "2024" } = Astro.props;
---
<div class="grow">
    <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-1">
        <h3 class="font-serif text-lg font-semibold text-ink">{degree}</h3>
        <span class="font-mono text-xs text-faint tabular-nums shrink-0">{startDate}–{endDate}</span>
    </div>
    <p class="text-sm text-muted font-medium mb-1">{institution}</p>
    {specialization && <p class="font-mono text-xs text-accent mb-2">{specialization}</p>}
    {description && <p class="text-sm text-muted leading-relaxed">{description}</p>}
    {list && (
        <ul class="mt-1.5 space-y-1">
            {list.map((item) => (
                <li class="text-sm text-muted leading-relaxed pl-4 relative before:content-['–'] before:absolute before:left-0 before:text-faint">{item}</li>
            ))}
        </ul>
    )}
</div>
